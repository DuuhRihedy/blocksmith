{
    "name": "@blocksmith/editor",
    "version": "0.1.0",
    "description": "A Notion-style block editor built with Tiptap and React",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./styles.css": "./dist/styles/editor.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "@tiptap/core": "^2.11.0",
        "@tiptap/extension-code-block-lowlight": "^2.11.0",
        "@tiptap/extension-color": "^3.20.0",
        "@tiptap/extension-image": "^2.11.0",
        "@tiptap/extension-link": "^2.11.0",
        "@tiptap/extension-placeholder": "^2.11.0",
        "@tiptap/extension-task-item": "^2.11.0",
        "@tiptap/extension-task-list": "^2.11.0",
        "@tiptap/extension-text-style": "^3.20.0",
        "@tiptap/extension-typography": "^2.11.0",
        "@tiptap/pm": "^2.11.0",
        "@tiptap/react": "^2.11.0",
        "@tiptap/starter-kit": "^2.11.0",
        "lowlight": "^3.2.0",
        "lucide-react": "^0.468.0",
        "tippy.js": "^6.3.7"
    },
    "devDependencies": {
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "tsup": "^8.3.0",
        "typescript": "^5.7.0"
    },
    "keywords": [
        "editor",
        "rich-text",
        "block-editor",
        "tiptap",
        "notion",
        "react"
    ],
    "license": "MIT"
}