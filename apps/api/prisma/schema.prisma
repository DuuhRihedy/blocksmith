datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Document {
  id        String   @id @default(cuid())
  title     String   @default("Sem título")
  content   String   @default("{}")
  emoji     String?  @default("📄")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
